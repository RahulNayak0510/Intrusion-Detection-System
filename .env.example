# -----------------------------------------------------------------------------
# Network Intrusion Detection System — Environment configuration
# Copy this file to `.env` BEFORE running `docker compose up`.
# Replace CHANGE_ME placeholders with strong random values. Do NOT commit .env.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# MySQL Server — Runtime connection
# App NEVER connects as root. MySQL init script creates the application user.
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=idsdb
MYSQL_USER=ids_user
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD

# -----------------------------------------------------------------------------
# Authentication — Analyst accounts
# FIRST_ADMIN_* seeds the first analyst account on startup (users table empty).
# JWT_SECRET is used for signing access tokens — use a long random string.
# -----------------------------------------------------------------------------
FIRST_ADMIN_USERNAME=analyst
FIRST_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# -----------------------------------------------------------------------------
# CORS — Frontend origins allowed to call the API
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Ingestion
# EVE_FILE_PATH: path to a Suricata EVE JSON log file. The default demo value
#   points to an empty file so the background tailer idles safely on startup.
# AUTO_REPLAY_SAMPLE_ON_STARTUP=1 will replay data/sample_eve.json once.
# -----------------------------------------------------------------------------
EVE_FILE_PATH=/app/data/empty_eve.json
AUTO_REPLAY_SAMPLE_ON_STARTUP=1
INGESTION_POLL_INTERVAL_SECONDS=1.0
INGESTION_READ_ERROR_MAX_BACKOFF_SECONDS=30

# -----------------------------------------------------------------------------
# Anomaly scoring — SECONDARY HEURISTIC ONLY, never replaces Suricata rules.
# ANOMALY_ENABLED=false by default (safe). Change to true to opt in.
# -----------------------------------------------------------------------------
ANOMALY_ENABLED=false
ANOMALY_SAMPLE_FOR_INITIAL_FIT=500

# -----------------------------------------------------------------------------
# Allowlists / asset labels
# Comma-separated CIDRs for allowlisting (flagged but NOT auto-suppressed).
# -----------------------------------------------------------------------------
ALLOWLIST_CIDRS=127.0.0.1/32,10.0.0.0/8
ASSET_LABELS_JSON={}

# -----------------------------------------------------------------------------
# Severity mapping: Suricata integer severity (1 highest..3 lowest) to labels
# -----------------------------------------------------------------------------
SEVERITY_MAP_JSON={"1":"HIGH","2":"MEDIUM","3":"LOW"}

# -----------------------------------------------------------------------------
# Retention — prevent unbounded storage growth
# RETENTION_DAYS: events older than this are pruned once per day at startup.
# -----------------------------------------------------------------------------
RETENTION_DAYS=30
